# Copie este archivo como .env y ajuste los valores para su equipo.
# El archivo .env no se sube al repositorio (cada integrante tiene su ruta).
# Revisar README.md para ver la especificacion de cada variable.

# Ruta de MATLAB, solo si no esta en el PATH (tambien sirve la variable MATLAB_BIN).
# Windows:
# DEFAULT_MATLAB=C:/Program Files/MATLAB/R2026a/bin/matlab.exe
# Linux:
# DEFAULT_MATLAB=/usr/local/MATLAB/R2026a/bin/matlab

# Dashboard (opcional, por defecto 127.0.0.1:5000)
# HOST=127.0.0.1
# PORT=5000


# FLASK_DEBUG=0
# SECRET_KEY=dev-secret-change-me
# CORS_ORIGINS=
# DATABASE_PATH=

# Modo del orquestador: once | full | continuous
# MODE=continuous

# Segundos entre horas simulada y tiempo para once
# SIM_INTERVAL=2
# ONCE_TIMEOUT=3600

# Asistente IA (Ollama). Requiere `ollama signin` una vez. El modelo por
# defecto es el unico gratuito de Ollama Cloud y soporta herramientas.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:cloud
# OLLAMA_TIMEOUT=120
# PRECIO_KWH=0.0
# CURRENCY=USD