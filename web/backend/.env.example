# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Database path (relative to project root)
DATABASE_PATH=../../data/spacewise.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,http://127.0.0.1:8000

# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# Server configuration
HOST=0.0.0.0
PORT=5000

# Asistente IA (Ollama) — todo opcional, estos son los valores por defecto.
# El modelo por defecto es el unico del plan gratuito de Ollama Cloud y soporta
# herramientas. Requiere `ollama signin` una vez. Cambia OLLAMA_MODEL si agregas
# creditos (p. ej. glm-5.3-flash:cloud, deepseek-v4.1-flash:cloud).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:cloud
OLLAMA_TIMEOUT=120

# Precio por kWh para convertir energia en dinero (0 = no estimar costo) y
# etiqueta de moneda que usa el asistente al reportar costos.
PRECIO_KWH=0.0
CURRENCY=USD
